FROM alpine:latest

ENV DROPBEAR_VERSION=2024.84

RUN apk add --no-cache \
    build-base \
    wget \
    tar \
    zlib-dev \
    openssl-dev \
    musl-dev \
    util-linux \
    linux-pam-dev \
    shadow

RUN adduser -D -s /bin/sh learner

RUN wget https://matt.ucc.asn.au/dropbear/releases/dropbear-${DROPBEAR_VERSION}.tar.bz2 \
    && tar -xjf dropbear-${DROPBEAR_VERSION}.tar.bz2 \
    && cd dropbear-${DROPBEAR_VERSION} \
    && ./configure --disable-loginfunc --disable-shadow --disable-lastlog --disable-utmp --disable-wtmp \
    && make -j$(nproc) \
    && make install \
    && cd .. \
    && rm -rf dropbear-${DROPBEAR_VERSION} dropbear-${DROPBEAR_VERSION}.tar.bz2 \
    && apk del build-base wget tar

RUN mkdir -p /etc/dropbear \
    && dropbearkey -t rsa -f /etc/dropbear/dropbear_rsa_host_key \
    && dropbearkey -t ecdsa -f /etc/dropbear/dropbear_ecdsa_host_key \
    && dropbearkey -t ed25519 -f /etc/dropbear/dropbear_ed25519_host_key

RUN chown -R learner:learner /etc/dropbear \
    && chmod 700 /etc/dropbear \
    && chmod 600 /etc/dropbear/*

USER learner

RUN mkdir -p /home/learner/.ssh \
    && chmod 700 /home/learner/.ssh

EXPOSE 22

CMD ["/usr/local/sbin/dropbear", "-F", "-E", "-s", "-p", "22", "-i"]