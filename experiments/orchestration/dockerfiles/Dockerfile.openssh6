FROM ubuntu:trusty

USER root

# Install OpenSSH server and sudo
RUN apt-get update && apt-get install -y openssh-server sudo && \
    rm -rf /var/lib/apt/lists/*

# Create 'learner' user with UID 1000
RUN useradd -m -u 1000 -s /bin/bash learner && \
    echo "learner ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Create necessary directories for sshd and learner
RUN mkdir -p /home/learner/.ssh /home/learner/etc/ssh /run/sshd && \
    chown -R learner:learner /home/learner && \
    chown root:root /run/sshd && \
    chmod 755 /run/sshd && \
    chmod 700 /home/learner/.ssh /home/learner/etc/ssh

# Generate HOST keys (Server Identity) explicitly in the learner's directory
RUN ssh-keygen -q -t rsa -N "" -f /home/learner/etc/ssh/ssh_host_rsa_key && \
    ssh-keygen -q -t dsa -N "" -f /home/learner/etc/ssh/ssh_host_dsa_key && \
    chown learner:learner /home/learner/etc/ssh/* && \
    chmod 600 /home/learner/etc/ssh/*

# Switch to learner user for the rest of the build and runtime
USER learner
WORKDIR /home/learner

# Create a custom sshd_config that doesn't require root privileges
RUN echo "Port 2222" > /home/learner/sshd_config && \
    echo "Protocol 2" >> /home/learner/sshd_config && \
    echo "HostKey /home/learner/etc/ssh/ssh_host_rsa_key" >> /home/learner/sshd_config && \
    echo "LogLevel DEBUG3" >> /home/learner/sshd_config && \
    echo "PubkeyAuthentication yes" >> /home/learner/sshd_config && \
    echo "AuthorizedKeysFile /home/learner/.ssh/authorized_keys" >> /home/learner/sshd_config && \
    echo "PasswordAuthentication no" >> /home/learner/sshd_config && \
    echo "ChallengeResponseAuthentication no" >> /home/learner/sshd_config && \
    echo "UsePAM no" >> /home/learner/sshd_config && \
    echo "PidFile /home/learner/sshd.pid" >> /home/learner/sshd_config && \
    echo "Subsystem sftp internal-sftp" >> /home/learner/sshd_config

EXPOSE 2222

# Start sshd using the custom non-root configuration
CMD ["/usr/sbin/sshd", "-D", "-e", "-f", "/home/learner/sshd_config"]
